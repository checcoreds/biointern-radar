{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "biointern-dev",
      "runtimeExecutable": "/bin/zsh",
      "runtimeArgs": [
        "-c",
        "export PATH=\"$HOME/.nvm/versions/node/v24.16.0/bin:$PATH\" && npm run dev"
      ],
      "port": 5173,
      "url": "http://127.0.0.1:5173",
      "autoPort": false
    },
    {
      "name": "biointern-preview",
      "runtimeExecutable": "/bin/zsh",
      "runtimeArgs": [
        "-c",
        "export PATH=\"$HOME/.nvm/versions/node/v24.16.0/bin:$PATH\" && npm run build && npm run preview"
      ],
      "port": 4173,
      "url": "http://127.0.0.1:4173",
      "autoPort": false
    }
  ]
}
