// Cloudflare deployment: the built site in dist/ is served as static files.
// There is no server code. Unknown paths fall back to index.html so the
// app's own router can show the page (or its not-found screen), and
// public/_headers is copied into dist/ to set the security headers.
{
  "name": "biointern-radar",
  "compatibility_date": "2026-11-11",
  "assets": {
    "directory": "./dist/",
    "not_found_handling": "single-page-application",
  },
}
